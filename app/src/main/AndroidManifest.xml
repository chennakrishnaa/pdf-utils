<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app is fully offline and requests no permissions. Strip what AndroidX merges in. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".PdfUtilApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfUtils"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for a PDF: content: Uris only, read once with the caller's transient
                 grant. singleTask: one instance, so a PDF opened from another app goes to the
                 reader on top of the existing back stack (onNewIntent) instead of a second copy
                 of the app sharing the same jobs and engine. Back from a document opened this way
                 moves the task to the back, so the app that opened it shows again. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- MuPDF runs here, in its own process, so a hostile file can only kill this process.
             Bound by RemoteEngine in the UI process; not exported, no intent filter. -->
        <service
            android:name=".engine.remote.EngineService"
            android:exported="false"
            android:process=":engine" />

        <!-- Hands a copy of a result to the app the user shares it with (temporary read grant via
             the share intent). Not exported; exposes only cacheDir/shared/ (see share_paths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Exported receiver merged in by androidx.profileinstaller; not wanted in this app.
             The class is only on the runtime classpath, hence the MissingClass suppression. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
