<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default name suggested in the save dialog. -->
    <string name="core_default_file_name" translatable="false">document.pdf</string>
    <!-- Shown while the finished PDF is being copied to the chosen location. -->
    <string name="core_saving">Saving…</string>
    <!-- Shown when the save dialog returns but the result was lost (e.g. the app was closed meanwhile). -->
    <string name="core_result_unavailable">The result is no longer available. Please run it again.</string>
    <!-- Leave-confirmation dialog shown on Back while a job runs or a result is unsaved. -->
    <!-- Shown when no app on the device can handle the document picker, photo picker or save dialog. -->
    <string name="core_no_picker">No app on this device can open the file picker.</string>
    <!-- Shown when a picked image declares more pixels than the app can safely decode on a phone. -->
    <string name="core_error_image_too_large">This image is too large to process on this device.</string>
</resources>
